{
  "name": "siomporas-solitaire",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Klondike, Spider and FreeCell that install once and play offline.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "node --test src/engine/*.test.ts",
    "icons": "node scripts/icons.mjs",
    "offline": "node scripts/offline-check.mjs",
    "deploy": "npm run build && wrangler deploy",
    "smoke": "node scripts/smoke.mjs",
    "drag": "node scripts/drag-check.mjs",
    "touch": "node scripts/touch-check.mjs",
    "layout": "node scripts/layout-probe.mjs",
    "cheats": "node scripts/cheats-check.mjs",
    "waste": "node scripts/waste-check.mjs"
  },
  "dependencies": {
    "@preact/signals": "^2.3.1",
    "preact": "^10.27.2"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.2",
    "@types/node": "^24.19.2",
    "playwright": "^1.61.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vite-plugin-pwa": "^1.3.0",
    "wrangler": "4.158.0"
  }
}
