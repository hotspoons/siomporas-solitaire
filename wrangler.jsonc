{
  // Static assets only; there is no Worker code. Every unknown path falls back
  // to index.html so a shared link opens the app.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "siomporas-solitaire",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [{ "pattern": "solitaire.siomporas.com", "custom_domain": true }],
  "workers_dev": true,
  "observability": { "enabled": true }
}
